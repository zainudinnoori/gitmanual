{
  "name": "gitmanual",
  "version": "0.1.0",
  "private": true,
  "description": "Paste any GitHub repo and get its setup manual: will it work on your device, what you need, and the steps for macOS, Windows or Linux.",
  "keywords": [
    "github",
    "setup",
    "installation",
    "open-source",
    "developer-tools",
    "nextjs"
  ],
  "homepage": "https://gitmanual.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/zainudinnoori/gitmanual.git"
  },
  "bugs": {
    "url": "https://github.com/zainudinnoori/gitmanual/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/push-to-turso.mjs",
    "check:scripts": "node --env-file-if-exists=.env.local --import tsx scripts/check-setup-scripts.ts",
    "setup-script": "node --env-file-if-exists=.env.local --import tsx scripts/print-setup-script.ts",
    "extension:zip": "cd extension && rm -f ../gitmanual-extension.zip && zip -qr ../gitmanual-extension.zip manifest.json background.js content.js content.css icons",
    "accuracy:sample": "node --import tsx scripts/make-accuracy-sample.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@vercel/analytics": "^2.0.1",
    "mcp-handler": "^2.3.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
