{
  "manifest_version": 3,
  "name": "gitmanual: setup manual for any GitHub repo",
  "short_name": "gitmanual",
  "version": "1.1.0",
  "description": "Setup manuals for GitHub repos, and GitManual AI Agent in the side panel to answer setup questions from the repo's own files.",
  "homepage_url": "https://gitmanual.com",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Ask about this repo, or open its setup manual", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "sidebar_action": { "default_panel": "sidepanel.html", "default_title": "Ask about this repo", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }, "open_at_install": false },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "permissions": ["activeTab", "sidePanel", "storage"],
  "host_permissions": ["https://gitmanual.com/*"],
  "content_scripts": [
    { "matches": ["https://github.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }
  ],
  "browser_specific_settings": { "gecko": { "id": "extension@gitmanual.com", "strict_min_version": "140.0", "data_collection_permissions": { "required": ["none"] } }, "gecko_android": { "strict_min_version": "142.0" } }
}
