# Copy to .env.local for development, or add these in Vercel → Project → Settings → Environment Variables.

# Recommended (required in production): raises the GitHub API limit from 60 to 5,000 requests/hour.
# Create a fine-grained token with no extra permissions at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# History, caching and votes. Leave empty locally to use data/gitmanual.db.
# turso db create gitmanual && turso db show gitmanual --url && turso db tokens create gitmanual
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: enables "Write my guide" (Claude). Each repo/OS guide is generated once, then cached.
ANTHROPIC_API_KEY=

# Optional: chat about a repo, for people signed in with GitHub (needs ANTHROPIC_API_KEY, the GitHub App settings
# below and a database). Off unless set to "on". Limits and the daily budget are in lib/budget.ts.
# CHAT_ENABLED=on
# Which model answers: claude-sonnet-5-5 (the default) or claude-haiku-5-5.
# CHAT_MODEL=claude-sonnet-5-5

# Optional: gitmanual's own GitHub repo (e.g. https://github.com/you/gitmanual). Adds the GitHub link with its star count
# to the menu and the "Report a wrong setup" button on /how-it-works.
NEXT_PUBLIC_REPO_URL=

# The public address of the site (e.g. https://gitmanual.com). Used for canonical links, the sitemap and share images.
NEXT_PUBLIC_SITE_URL=

# Optional: sync the Facebook Page's posts into /finds (see README → "Sync from Facebook").
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Protects /api/cron/facebook; Vercel Cron sends it automatically. Any long random string.
CRON_SECRET=

# Optional: the Finds page (posts from your Facebook Page). Off unless FINDS_NAME is set.
FINDS_NAME=
FINDS_ABOUT=
FINDS_URL=
# Defaults to the Page's own profile picture when FB_PAGE_ID is set.
FINDS_AVATAR=

# Rate limits are on by default. Any long random string here keeps the daily visitor codes unguessable.
LIMIT_SALT=
# Optional: "off" turns rate limits off (e.g. for a private deployment).
RATE_LIMITS=

# Optional: a ShareText form's embed link (https://sharetext.net/form/<code>/embed) for "Contact" in the footer.
CONTACT_FORM_URL=

# Optional: the browser extension's store page, linked from the footer and the home page.
NEXT_CHROME_EXTENSION_URL=

# Optional: the Product Hunt launch page (https://www.producthunt.com/posts/...). While set, a strip above the menu
# links to it; remove it after launch day.
PRODUCT_HUNT_URL=

# Optional: Carbon ads (one per page on manual pages of public repos, the shelf, lists and /developers). Both come from
# the ad tag in Carbon's dashboard: carbon.js?serve=<SERVE>&placement=<PLACEMENT>. `next dev` shows a placeholder instead.
NEXT_PUBLIC_CARBON_SERVE=
NEXT_PUBLIC_CARBON_PLACEMENT=

# Optional: IndexNow, so Bing and others hear about each new manual right away. Any 32 letters/digits
# (openssl rand -hex 16); it's served publicly at /indexnow-key.txt, so it isn't a secret. Only used on an https site.
INDEXNOW_KEY=

# Optional: private repos through "Connect GitHub" (without these, visitors can still paste their own read-only token).
# Create a GitHub App at https://github.com/settings/apps/new (see README → "Private repos"). The slug is the end of
# its public link, github.com/apps/<slug>.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional: GitHub usernames (comma-separated) who can see and turn off API keys at /admin/keys.
ADMIN_GITHUB_LOGINS=
# Encrypts the visitor's GitHub sign-in cookie. Any long random string (openssl rand -hex 32); changing it signs everyone out.
SESSION_SECRET=
